# OPCIONAL — a demonstração funciona sem este arquivo, com o login
# demo / claquete exibido na tela de entrada.
#
# Para usar senhas próprias, copie este arquivo para ".streamlit/secrets.toml"
# (sem o ".example") e troque pelos hashes gerados. Quando existe ao menos uma
# senha aqui, o login de demonstração deixa de valer.
#
# O arquivo secrets.toml está no .gitignore e NUNCA deve ser enviado ao
# GitHub. No Streamlit Community Cloud, o mesmo conteúdo vai no campo
# "Secrets" das configurações do app.

# Gere cada linha com:   python scripts/gerar_senha.py
# O valor guardado é um "hash" — não é possível descobrir a senha a partir dele.

[senhas]
Ana = "pbkdf2_sha256$200000$COLE_AQUI_O_HASH_GERADO"
